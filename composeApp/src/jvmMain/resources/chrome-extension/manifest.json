{
  "manifest_version": 3,
  "name": "AutoPilot Page Helper",
  "version": "1.13.0",
  "description": "Scroll-and-click, Sagar Mein Yog and DGS E-Learning routines controlled by your local app.",
  "key": "",
  "permissions": [
    "alarms",
    "debugger"
  ],
  "host_permissions": [
    "http://127.0.0.1:47613/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "course-automation.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://dgsstcwlms.aduacademy.in/*",
        "https://*.youtube.com/embed/*",
        "https://*.youtube-nocookie.com/embed/*"
      ],
      "js": [
        "dgs-elearning.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ]
}
