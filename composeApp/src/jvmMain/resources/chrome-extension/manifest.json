{
  "manifest_version": 3,
  "name": "AutoClicker Page Helper",
  "version": "1.9.9",
  "description": "Scroll-and-click runs and Sagar Mein Yog automation. Acts on app commands and talks only to this computer.",
  "key": "",
  "permissions": ["alarms"],
  "host_permissions": ["http://127.0.0.1:47613/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["content.js"], "all_frames": true, "match_about_blank": true, "run_at": "document_idle" },
    { "matches": ["<all_urls>"], "js": ["course-automation.js"], "all_frames": true, "match_about_blank": true, "run_at": "document_idle" }
  ]
}
