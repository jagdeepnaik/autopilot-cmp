# private/ layout: see "Private folder" in AGENTS.md.
# Tracked: private/docs/, private/scripts/ and project data such as private/answer-banks/.
# Temporary or unimportant files (backups, screenshots, research, reports, scratch) go in
# private/misc/, which never reaches Git.
/private/misc/
# Working plans stay local.
/private/plans/
# Android release signing: never commit
/private/signing/
keystore.properties
*.jks
*.keystore
# Read-only reference copy of the template
/private/zynk-cmp-main/
/private/secrets/
