    ssh -tt "$MAC_LINUX_HOST" "sudo apt-get install -y '$deb'" \
        || fail "the Mac Linux VM DEB install failed (see above)."
    echo "Installed $deb on the Mac Linux VM."
}

local_windows_debug() {
