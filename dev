# --- Machine data sync --------------------------------------------------------------------------
# This copies app data, not source code: the hidden .autopilot folder contains local progress and
# settings, while Downloads/AutoPilot/Profile contains downloaded certificates. Existing files in the Mac
# Sync folder are updated; nothing is deleted. Data collection is best-effort: an offline machine
# is skipped after a short connection timeout and the next machine is processed.
DATA_SSH_OPTS=(-o ConnectTimeout=8 -o ConnectionAttempts=1)
copy_local_tree() {
    local source="$1" destination="$2"
    [ -d "$source" ] || { echo "Not present: $source (skipped)"; return 0; }
    mkdir -p "$destination"
    tar -C "$source" -cf - . | tar -C "$destination" -xf -
    echo "Copied $source -> $destination"
}

copy_local_downloads_tree() {
    local source="$1" destination="$2"
    [ -d "$source" ] || { echo "Not present: $source (skipped)"; return 0; }
    mkdir -p "$destination"
    # The per-machine folders live inside this source. Exclude them so a repeated sync cannot
    # recurse into its own previous output; also omit installers and scratch answer-bank exports.
    tar -C "$source" \
        --exclude='./Sync' --exclude='./mac' --exclude='./legion' --exclude='./home-server' \
        --exclude='./home-server-vm-win' --exclude='./mac-vm-win' --exclude='./mac-vm-linux' \
        --exclude='./Builds' --exclude='./Misc' \
        -cf - . | tar -C "$destination" -xf -
    echo "Copied $source (excluding machine folders) -> $destination"
}

copy_unix_tree() {
    local label="$1" host="$2" source="$3" destination="$4"
    if ! ssh "${DATA_SSH_OPTS[@]}" "$host" "test -d '$source'"; then
        echo "$label: not present: $source (skipped)"
        return 0
    fi
    mkdir -p "$destination"
    if ! ssh "${DATA_SSH_OPTS[@]}" "$host" "tar -C '$source' -cf - ." | tar -C "$destination" -xf -; then
        echo "$label: couldn't copy $source (skipped)"
        return 0
    fi
    echo "$label: copied $source -> $destination"
}

copy_unix_downloads_tree() {
    local label="$1" host="$2" source="$3" destination="$4"
    if ! ssh "${DATA_SSH_OPTS[@]}" "$host" "test -d '$source'"; then
        echo "$label: not present: $source (skipped)"
        return 0
    fi
    mkdir -p "$destination"
    if ! ssh "${DATA_SSH_OPTS[@]}" "$host" "tar -C '$source' --exclude='./Builds' --exclude='./Sync' --exclude='./Misc' -cf - ." | tar -C "$destination" -xf -; then
        echo "$label: couldn't copy $source (skipped)"
        return 0
    fi
    echo "$label: copied profile/download folders from $source -> $destination (excluding Builds, Sync and Misc)"
}

copy_windows_tree() {
    local label="$1" host="$2" source="$3" destination="$4" parent
    if ! windows_ps_raw "$host" "if (-not (Test-Path -LiteralPath '$source' -PathType Container)) { exit 3 }" >/dev/null; then
        echo "$label: not present: $source (skipped)"
        return 0
    fi
    parent=$(dirname "$destination")
    mkdir -p "$parent"
    if ! windows_scp "$host" "$source" "$parent/" recursive; then
        echo "$label: couldn't copy $source (skipped)"
        return 0
    fi
    echo "$label: copied $source -> $destination"
}

copy_windows_downloads_tree() {
    local label="$1" host="$2" source="$3" destination="$4" names name
    if ! windows_ps_raw "$host" "if (-not (Test-Path -LiteralPath '$source' -PathType Container)) { exit 3 }" >/dev/null; then
        echo "$label: not present: $source (skipped)"
        return 0
    fi
    names=$(windows_ps_raw "$host" "Get-ChildItem -LiteralPath '$source' -Directory | Where-Object { \$_.Name -notin @('Builds','Sync','Misc') } | ForEach-Object { \$_.Name }" | tr -d '\r') || {
        echo "$label: couldn't list $source (skipped)"
        return 0
    }
    mkdir -p "$destination"
    while IFS= read -r name; do
        [ -n "$name" ] || continue
        if ! windows_scp "$host" "$source/$name" "$destination/" recursive; then
            echo "$label: couldn't copy $name from $source (skipped)"
            continue
        fi
    done <<< "$names"
    echo "$label: copied profile/download folders from $source -> $destination (excluding Builds, Sync and Misc)"
}

sync_database_local() {
