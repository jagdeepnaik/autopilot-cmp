        merge-answer-bank:all) merge_answer_bank ;;

        build:mac) mac_build ;;
        build:legion) legion_build ;;
        build:home-server) server_build ;;
        build:home-server-vm-win) vm_build ;;
        build:mac-vm-win) local_windows_build ;;
        build:mac-vm-linux) local_linux_build ;;
        build:local-all) local_all_build ;;
        build:all) mac_check_pushed; mac_build; legion_build; server_build; vm_build; local_windows_build; local_linux_build ;;

        run:mac) mac_build; mac_install ;;
        run:legion) legion_build; legion_install ;;
        run:home-server) server_build ;;
        run:home-server-vm-win) vm_build; vm_fetch ;;
        run:mac-vm-win) local_windows_build; local_windows_install ;;
        run:mac-vm-linux) local_linux_build; local_linux_install ;;
        run:local-all) local_all_install ;;
        run:all) mac_check_pushed; mac_build; mac_install; legion_build; legion_install; server_build; vm_build; vm_fetch; local_windows_build; local_windows_install; local_linux_build; local_linux_install ;;

        fetch:all) fetch_all_builds ;;
        fetch:legion) fetch_legion_builds ;;
        fetch:home-server) server_build; server_fetch ;;
        fetch:home-server-vm-win) vm_build; vm_fetch ;;
        fetch:mac|fetch:mac-vm-win|fetch:mac-vm-linux|fetch:local-all)
            unsupported fetch "This target does not copy an installer to the Mac." ;;

        debug:mac) mac_sync; mac_debug ;;
        debug:legion) legion_debug ;;
        debug:mac-vm-win) local_windows_debug ;;
        debug:mac-vm-linux) local_linux_debug ;;
        debug:home-server|debug:home-server-vm-win|debug:local-all|debug:all)
            unsupported debug "Debug one desktop at a time: use mac, legion, mac-vm-win or mac-vm-linux." ;;

        *) fail "'$action' isn't available for $TARGET. See --help." ;;
    esac
}

for action in "${ACTIONS[@]}"; do
    run_action "$action"
done
step "Done"

}

git_main() {
# Git project commands.
set -euo pipefail

SCRIPT_DIR="$ROOT/private/scripts"

usage() {
    cat <<'EOF'
Project Git script

Usage:
  ./dev git <command> [arguments]

Command                         What it does
status                          Show the current branch and changed files.
check                           Fetch GitHub and show ahead/behind status.
fetch                           Download GitHub history without changing files.
pull                            Fast-forward clean main to the latest GitHub commit.
diff                            Show unstaged and staged changes.
history                         Show the latest 20 commits.
branches                        Show local branches and tracking state.
push-all                        Commit all non-ignored changes and push main.
push-all "Message"              Same as push-all with a custom commit message.

Safety:
  pull refuses to run with local changes.
  push-all only runs on main.
  This script has no reset --hard, clean -fd or force-push command.
EOF
}

COMMAND="${1:-}"
if [ -z "$COMMAND" ]; then
    usage >&2
    exit 2
fi
shift

cd "$ROOT"

require_main() {
    local branch
    branch="$(git branch --show-current)"
    if [ "$branch" != main ]; then
        echo "Stopped: this command only works on main; current branch is '$branch'." >&2
        exit 1
    fi
}

require_clean() {
    if [ -n "$(git status --porcelain)" ]; then
        git status --short
        echo "Stopped: the working tree has changes. Commit or stash them before pulling." >&2
        exit 1
    fi
}

case "$COMMAND" in
    status)
        git status -sb
        ;;
    check)
        git fetch --prune origin
        git status -sb
        ;;
    fetch)
        git fetch --prune origin
        echo "Fetched origin. Local files were not changed."
        ;;
    pull)
        require_main
        require_clean
        git pull --ff-only origin main
        ;;
    diff)
        git diff
        echo "--- staged changes ---"
        git diff --cached
        ;;
    history)
        git log --oneline --decorate -20
        ;;
    branches)
        git branch -vv
        ;;
    push-all)
        require_main
        MESSAGE="${*:-Update AutoPilot}"
        git add -A

        if git diff --cached --quiet; then
            echo "Nothing to commit. The working tree is already up to date."
            exit 0
        fi

        git commit -m "$MESSAGE"
        git push origin main
        ;;
    -h|--help|help)
        usage
        ;;
    *)
        echo "Unknown Git command: $COMMAND" >&2
        usage >&2
        exit 2
        ;;
esac
}

version_main() {
    set -euo pipefail

    local kind="${1:-}" catalog current major minor patch next tag temp

    version_usage() {
        cat <<'EOF'
Release version command

Usage:
  ./dev version <patch|minor|major>

Examples:
  ./dev version patch    # 1.1.0 -> 1.1.1
  ./dev version minor    # 1.1.1 -> 1.2.0
  ./dev version major    # 1.2.4 -> 2.0.0

This command requires a clean, up-to-date main branch. It updates versionName,
creates one release commit, creates an annotated v<version> tag, and pushes both.
The Git-generated build number continues increasing and is never reset.
EOF
    }

    case "$kind" in
        patch|minor|major) ;;
        -h|--help|help|'') version_usage; [ -n "$kind" ] && exit 0 || exit 2 ;;
        *) echo "Unknown version type: $kind" >&2; version_usage >&2; exit 2 ;;
    esac
    [ "$#" -eq 1 ] || { echo "Use exactly: ./dev version <patch|minor|major>." >&2; exit 2; }

    cd "$ROOT"
    [ "$(git branch --show-current)" = main ] || { echo "Stopped: releases only run on main." >&2; exit 1; }
    if [ -n "$(git status --porcelain)" ]; then
        git status --short
        echo "Stopped: commit, push, or stash the current changes before releasing a version." >&2
        exit 1
    fi

    git fetch --prune --tags origin
    git pull --ff-only origin main

    catalog="$ROOT/gradle/libs.versions.toml"
    current="$(awk -F'\"' '/^versionName = / { print $2 }' \"$catalog\")"
    [ -n "$current" ] || { echo "Stopped: versionName must be MAJOR.MINOR.PATCH." >&2; exit 1; }
    IFS=. read -r major minor patch <<<"$current"

    case "$kind" in
        patch) next="$major.$minor.$((patch + 1))" ;;
        minor) next="$major.$((minor + 1)).0" ;;
        major) next="$((major + 1)).0.0" ;;
    esac
    tag="v$next"
    git rev-parse -q --verify "refs/tags/$tag" >/dev/null && {
        echo "Stopped: tag $tag already exists. Choose the next release version." >&2
        exit 1
    }

    temp="$(mktemp "$catalog.tmp.XXXXXX")"
    trap 'rm -f "$temp"' RETURN
    awk -v version="$next" '
        /^versionName = / { printf "versionName = \"%s\"\n", version; replaced++; next }
        { print }
        END { if (replaced != 1) exit 1 }
    ' "$catalog" >"$temp" || { echo "Stopped: could not update versionName." >&2; exit 1; }
    mv "$temp" "$catalog"
    trap - RETURN

    git add "$catalog"
    git commit -m "Release $next"
    git tag -a "$tag" -m "Release $next"
    git push origin main
    git push origin "$tag"
    echo "Released $next. The next desktop build keeps its increasing Git build number."
}

home_server_main() {
    local action="${1:-}" host=home-server
    case "$action" in status|start|stop|restart) shift ;; -h|--help|help|'')
        cat <<'EOF'
Home server control
Usage: ./dev home-server <status|start|stop|restart> [--remote]
status: detailed Debian, resource, service, Docker, port and Windows VM status
start: check the server or wake it with SERVER_MAC and wakeonlan
stop: power off Debian cleanly; refuses while the Windows VM is running
restart: reboot Debian cleanly; refuses while the Windows VM is running
EOF
        [ -n "$action" ] && exit 0 || exit 2 ;;
        *) echo "Unknown action: $action (see --help)" >&2; exit 2 ;;
    esac
    [ "${1:-}" = --remote ] && host=home-server-remote
    ssh_server() { ssh -o ConnectTimeout=10 "$host" "$@"; }
    reachable() { ssh -o BatchMode=yes -o ConnectTimeout=5 "$host" true >/dev/null 2>&1; }
    status_server() {
        printf '\n\033[1m== Home server: %s\033[0m\n' "$host"
        ssh_server 'set -o pipefail
echo "Hostname:       $(hostname)"
echo "OS:             $(. /etc/os-release && printf "%s %s" "$PRETTY_NAME" "$VERSION")"
echo "Kernel:         $(uname -srmo)"
echo "Uptime:         $(uptime -p)"
echo "Load:           $(cut -d" " -f1-3 /proc/loadavg)"
echo "CPU:            $(nproc) logical CPUs; $(lscpu 2>/dev/null | awk -F: "/Model name/ {gsub(/^ +/, \"\", \$2); print \$2; exit}")"
free -h | awk "/^Mem:/ {print \"Memory:         \" \$3 \" used / \" \$2 \" total; \" \$7 \" available\"}"
df -h -P / /srv 2>/dev/null | tail -n +2 | awk "!seen[\$6]++ {print \"Disk:           \" \$6 \" \" \$3 \" used / \" \$2 \" total (\" \$5 \" used)\"}"
echo "Addresses:      $(hostname -I 2>/dev/null | xargs)"
echo "SSH:            $(systemctl is-active ssh 2>/dev/null || systemctl is-active sshd 2>/dev/null || true)"
echo "Docker:         $(systemctl is-active docker 2>/dev/null || true)"
failed=$(systemctl --failed --no-legend --plain 2>/dev/null | sed "/^$/d" | head -20); if [ -n "$failed" ]; then echo "Failed units:"; printf "%s\n" "$failed"; else echo "Failed units:   none"; fi
echo "Docker containers:"; command -v docker >/dev/null && docker ps --format "  {{.Names}}  {{.Status}}  {{.Ports}}" 2>/dev/null || echo "  unavailable"
echo "Listening ports:"; ss -H -ltn 2>/dev/null | awk "{print \"  \" \$4}" | head -30
pgrep -af "qemu-system.*windows-build" >/dev/null 2>&1 && echo "Windows VM:      running" || echo "Windows VM:      stopped"
if [ -d /srv/build/autopilot-cmp/.git ]; then echo "AutoPilot:       $(git -C /srv/build/autopilot-cmp log -1 --format="%h %s")"; else echo "AutoPilot:       checkout missing"; fi'
    }
    power_server() {
        local operation="$1"
        reachable || { echo "Can't reach $host. Check the network, or add --remote." >&2; exit 1; }
        ssh_server 'pgrep -f "qemu-system.*windows-build" >/dev/null 2>&1' && { echo "Stop the Windows VM first with ./dev home-server-vm-win stop." >&2; exit 1; } || true
        ssh -tt "$host" "sudo systemctl $operation"
    }
    case "$action" in
        status) status_server ;;
        start)
            if reachable; then
                status_server
            else
                [ -n "${SERVER_MAC:-}" ] && command -v wakeonlan >/dev/null 2>&1 || { echo "Set SERVER_MAC and install wakeonlan to start an offline server." >&2; exit 1; }
                wakeonlan "$SERVER_MAC" >/dev/null
                waited=0
                until reachable; do
                    [ "$waited" -ge 180 ] && { echo "The home server did not answer SSH within 3 minutes." >&2; exit 1; }
                    sleep 5; waited=$((waited + 5)); printf '.'
                done
                echo
                status_server
            fi
            ;;
        stop) power_server poweroff ;;
        restart) power_server reboot ;;
    esac
}

vm_main() {
# Start, stop, check or test the Windows build VM on the home server, from the Mac, in one line.
#
#   ./dev home-server-vm-win status            # is the VM running, and does Windows answer?
#   ./dev home-server-vm-win test              # sign in to Windows and check the build tools
#   ./dev home-server-vm-win start             # start it; you type the VNC console password
#   ./dev home-server-vm-win start --headless  # start it with a random console password (no prompt)
#   ./dev home-server-vm-win stop              # shut Windows down cleanly and wait for the VM to end
#   add --remote to explicitly use Cloudflare; without it, the local SSH route is used
#
# Only the Windows guest starts or stops; Debian and the websites are never touched. A stop is
# refused while a Gradle build is running in the VM, and the VM is never force-killed.
set -euo pipefail

SCRIPT="$ROOT/dev"
SERVER_HOST=home-server
VM_HOST=server-vm
VM_JUMP_HOST=home-server
VM_USER=builduser
VM_PORT=2222
VM_DIR='/srv/vms/windows-build'
WINDOWS_CHECKOUT='C:\Build\autopilot-cmp'
REMOTE_MODE=0

usage() { awk 'NR == 1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "$SCRIPT"; }
ACTION="${1:-}"
case "$ACTION" in status|test|start|stop) shift ;; -h|--help|help) usage; exit 0 ;; '') usage; exit 2 ;; *) echo "Unknown action: $ACTION (see --help)" >&2; exit 2 ;; esac
HEADLESS=0
for arg in "$@"; do
    case "$arg" in
        --headless) HEADLESS=1 ;;
        --remote) REMOTE_MODE=1; SERVER_HOST=home-server-remote; VM_JUMP_HOST=home-server-remote ;;
        *) echo "Unknown option: $arg (see --help)" >&2; exit 2 ;;
    esac
done

step() { printf '\n\033[1m== %s\033[0m\n' "$*"; }
fail() { printf '\n\033[31mStopped: %s\033[0m\n' "$*" >&2; exit 1; }
ok() { printf '\033[32m%s\033[0m\n' "$*"; }

vm_running() { ssh "$SERVER_HOST" "pgrep -f '^/usr/bin/qemu-system-x86_64 -name windows-build ' >/dev/null"; }
# A fresh connection each time (-S none), so a shared one can't hide that Windows went away.
windows_answers() { windows_ssh "$VM_HOST" "echo ready" 2>/dev/null | grep -q ready; }
windows_ps() {
    local encoded
    encoded=$(printf '%s' "\$ErrorActionPreference = 'Stop'; \$ProgressPreference = 'SilentlyContinue'
$1" | iconv -f UTF-8 -t UTF-16LE | base64 | tr -d '\n')
    windows_ssh "$VM_HOST" "powershell -NoProfile -EncodedCommand $encoded"
}

status() {
    step "Server: $SERVER_HOST"
    ssh -o ConnectTimeout=10 "$SERVER_HOST" "echo \"Debian up: \$(uptime -p)\"; free -h | awk '/^Mem:/ {print \"Host memory: \" \$3 \" used, \" \$7 \" available of \" \$2}'" \
        || fail "can't reach $SERVER_HOST. Check the network, or add --remote."
    step "Windows VM"
    if vm_running; then
        ok "VM process: running"
        ssh "$SERVER_HOST" "ss -ltn | grep -qE '127\.0\.0\.1:2222\b' && echo 'SSH forward: listening on 127.0.0.1:2222' || echo 'SSH forward: not listening yet'"
        if windows_answers; then ok "Windows SSH: answering"; else echo "Windows SSH: not answering yet (still booting, or updating)"; fi
    else
        echo "VM process: stopped"
    fi
}

test_connection() {
    vm_running || fail "the VM is stopped. Start it with: $0 start --headless"
    step "Windows VM: sign in and check the build tools"
    windows_ps "
'Signed in as:   ' + (whoami)
'Computer:       ' + \$env:COMPUTERNAME
'Windows uptime: ' + ((Get-Date) - (Get-CimInstance Win32_OperatingSystem).LastBootUpTime).ToString('d\\.hh\\:mm')
'Java:           ' + (cmd /c 'java -version 2>&1' | Select-Object -First 1)
'Git:            ' + (git --version)
if (Test-Path '$WINDOWS_CHECKOUT') {
    Set-Location '$WINDOWS_CHECKOUT'
    'Checkout:       ' + (git log -1 --format='%h %s')
    \$dirty = @(git status --porcelain).Count
    'Local changes:  ' + \$(if (\$dirty) { \"\$dirty file(s)\" } else { 'none' })
} else { 'Checkout:       missing at $WINDOWS_CHECKOUT' }
\$free = (Get-PSDrive C).Free / 1GB
'Free on C:      ' + [math]::Round(\$free, 1) + ' GB'
" || fail "the connection test failed (see above)."
    ok "Connection test passed."
}

start() {
    if vm_running; then
        echo "The VM is already running."
    else
        step "Server: start the Windows VM"
        if [ "$HEADLESS" -eq 1 ]; then
            # A random console password, piped to start.sh's prompt and never shown or stored.
            { LC_ALL=C tr -dc 'A-Za-z0-9' </dev/urandom | head -c 8; echo; } | ssh "$SERVER_HOST" "$VM_DIR/start.sh" \
                || fail "start.sh failed (see above)."
            echo "Started headless: the VNC console password was random. Run 'start' without --headless next time to use the console."
        else
            echo "start.sh asks for an 8-character VNC console password (letters/numbers). It's only for Screen Sharing."
            ssh -t "$SERVER_HOST" "$VM_DIR/start.sh" || fail "start.sh failed (see above)."
        fi
    fi
    step "Waiting for Windows to answer over SSH (up to 10 minutes)"
    local waited=0
    until windows_answers; do
        [ "$waited" -ge 600 ] && fail "Windows didn't answer within 10 minutes. It may be installing updates: check it with Screen Sharing, or run '$0 status' later."
        sleep 10; waited=$((waited + 10)); printf '.'
    done
    [ "$waited" -gt 0 ] && echo
    ok "Windows is up after about ${waited}s."
    test_connection
}

stop() {
    vm_running || { echo "The VM is already stopped."; return 0; }
    step "Windows VM: check nothing is building"
    if windows_answers; then
        local busy
        busy=$(windows_ps "@(Get-CimInstance Win32_Process -Filter \"Name='java.exe'\" | Where-Object { \$_.CommandLine -match 'org\.gradle' }).Count" | tr -d '\r' || echo 0)
        [ "${busy:-0}" -eq 0 ] || fail "a Gradle build is running in the VM ($busy process(es)). Let it finish, or press Control-C in its window, then stop again."
        echo "No build running."
        step "Windows VM: shut down"
        windows_ps "Stop-Computer -Force" >/dev/null 2>&1 || true
    else
        fail "the VM is running but Windows doesn't answer over SSH, so it can't be shut down cleanly from here. Use Screen Sharing (Start → Power → Shut down); the VM is never force-killed."
    fi
    local waited=0
    until ! vm_running; do
        [ "$waited" -ge 300 ] && fail "Windows hasn't finished shutting down after 5 minutes (updates?). Check it with Screen Sharing; don't kill the VM."
        sleep 5; waited=$((waited + 5)); printf '.'
    done
    [ "$waited" -gt 0 ] && echo
    ok "The VM has stopped after about ${waited}s; its memory is free on the server."
}

case "$ACTION" in
    status) status ;;
    test) test_connection ;;
    start) start ;;
    stop) stop ;;
esac

}

command="${1:-}"
case "$command" in
    git)
        shift
        git_main "$@"
        ;;
    version)
        shift
        version_main "$@"
        ;;
    home-server)
        shift
        home_server_main "$@"
        ;;
    home-server-vm-win)
        shift
        vm_main "$@"
        ;;
        sync|sync-database|sync-certificates|merge-answer-bank|build|run|fetch|debug|--no-tests|--remote)
        desktop_main "$@"
        ;;
    -h|--help|help|'')
        dev_usage
        ;;
    *)
        echo "Unknown command: $command" >&2
        dev_usage >&2
        exit 2
        ;;
esac
