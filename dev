    deb=$(ssh "$MAC_LINUX_HOST" "find '$MAC_LINUX_DIR/desktopApp/build/compose/binaries/main-release/deb' -maxdepth 1 -type f -name '*.deb' -printf '%T@ %p\\n' | sort -nr | head -1 | cut -d' ' -f2-" | tr -d '\r') \
