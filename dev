copy_local_certificates() {
    local machine="$1" source="$2" destination="$SYNC_DATA_ROOT/$1/AutoPilot/Profile" file relative target copied=0 skipped=0
    step "$machine: copy certificates only"
    [ -d "$source" ] || { echo "$machine: no certificate folder: $source (skipped)"; return 0; }
    while IFS= read -r -d '' file; do
        relative="${file#"$source/"}"
        target="$destination/$relative"
        if [ -e "$target" ]; then
            skipped=$((skipped + 1))
            continue
        fi
        mkdir -p "$(dirname "$target")"
        cp "$file" "$target"
        copied=$((copied + 1))
    done < <(find "$source" -type f -print0)
    echo "$machine: copied $copied certificate(s), skipped $skipped existing file(s)"
}

copy_unix_certificates() {
    local machine="$1" host="$2" source="$3" destination="$SYNC_DATA_ROOT/$1/AutoPilot/Profile" names relative target copied=0 skipped=0
    step "$machine: copy certificates only"
    if ! ssh "${DATA_SSH_OPTS[@]}" "$host" "test -d '$source'"; then
        echo "$machine: no certificate folder: $source (skipped)"
        return 0
    fi
    names=$(ssh "${DATA_SSH_OPTS[@]}" "$host" "find '$source' -type f -printf '%P\\n'" 2>/dev/null) || {
        echo "$machine: couldn't list certificates (skipped)"
        return 0
    }
    while IFS= read -r relative; do
        [ -n "$relative" ] || continue
        target="$destination/$relative"
        if [ -e "$target" ]; then
            skipped=$((skipped + 1))
            continue
        fi
        mkdir -p "$(dirname "$target")"
        if scp "${DATA_SSH_OPTS[@]}" -q "$host:$source/$relative" "$target"; then
            copied=$((copied + 1))
        fi
    done <<< "$names"
    echo "$machine: copied $copied certificate(s), skipped $skipped existing file(s)"
}

copy_windows_certificates() {
    local machine="$1" host="$2" source="$3" destination="$SYNC_DATA_ROOT/$1/AutoPilot/Profile" names relative target copied=0 skipped=0
    step "$machine: copy certificates only"
    if ! windows_ps_raw "$host" "if (-not (Test-Path -LiteralPath '$source' -PathType Container)) { exit 3 }" >/dev/null; then
        echo "$machine: no certificate folder: $source (skipped)"
        return 0
    fi
    names=$(windows_ps_raw "$host" "\$root = '$source'; Get-ChildItem -LiteralPath \$root -File -Recurse | ForEach-Object { \$_.FullName.Substring(\$root.Length + 1) }" | tr -d '\r' | tr '\\' '/') || {
        echo "$machine: couldn't list certificates (skipped)"
        return 0
    }
    while IFS= read -r relative; do
        [ -n "$relative" ] || continue
        target="$destination/$relative"
        if [ -e "$target" ]; then
            skipped=$((skipped + 1))
            continue
        fi
        mkdir -p "$(dirname "$target")"
        if windows_scp "$host" "$source/$relative" "$target"; then
            copied=$((copied + 1))
        fi
    done <<< "$names"
    echo "$machine: copied $copied certificate(s), skipped $skipped existing file(s)"
}

sync_certificates_all() {
    step "Copy certificates only (existing destination files are preserved)"
    copy_local_certificates mac "$HOME/Downloads/AutoPilot/Profile"
    copy_windows_certificates legion "$LEGION_HOST" "$LEGION_HOME/Downloads/AutoPilot/Profile"
    copy_unix_certificates home-server "$SERVER_HOST" "$SERVER_HOME/Downloads/AutoPilot/Profile"
    copy_windows_certificates home-server-vm-win "$VM_HOST" "$VM_HOME/Downloads/AutoPilot/Profile"
    copy_windows_certificates mac-vm-win "$MAC_WINDOWS_HOST" "$MAC_WINDOWS_HOME/Downloads/AutoPilot/Profile"
